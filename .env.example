# ---------------------------------------------------------------------------
# RAITE 2026 Study Room - environment template
# Copy to `.env` (or `local.properties` for the Android app) and fill real values.
# NEVER commit real keys.
# ---------------------------------------------------------------------------

# ---- Supabase (safe to ship in the APK: protected by Row Level Security) ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# ---- AI proxy (deployed Ktor service) --------------------------------------
AI_PROXY_URL=https://your-ai-proxy-xxxx.a.run.app

# ---- ai-proxy ONLY (server-side secrets, never in the app) -----------------
# The service-role key bypasses RLS: keep it server-side only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Pick one: gemini | claude
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
